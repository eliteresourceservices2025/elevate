{
  "name": "elevate-hris",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter elevate dev",
    "build": "pnpm --filter elevate build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter elevate test:e2e",
    "db:generate": "pnpm --filter elevate db:generate",
    "db:migrate": "pnpm --filter elevate db:migrate",
    "db:seed": "pnpm --filter elevate db:seed"
  }
}
