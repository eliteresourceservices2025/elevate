# ELEVATE environment variables
# Copy to .env.local for development. Never commit real values.
# In Vercel: Production -> Supabase Pro project, Preview -> Supabase staging project.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ELEVATE

# --- Supabase (auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # publishable (anon) key: safe in browser, reads nothing (RLS deny-all)
SUPABASE_SECRET_KEY=                       # secret (service role) key: server-only, never NEXT_PUBLIC_

# --- Database (Drizzle) ---
DATABASE_URL=                              # transaction pooler, port 6543 (app runtime)
DATABASE_URL_DIRECT=                       # direct or session connection, port 5432 (migrations only)

# --- Field encryption (government IDs, payout details, pay rates) ---
FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64_KEY   # newest key first: v2:...,v1:...

# --- Access control ---
SUPER_ADMIN_EMAILS=                        # comma-separated; bootstraps the first Super Admin on first login

# --- Google (Calendar; sign-in itself is configured in Supabase) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=               # encrypts stored Calendar refresh tokens

# --- Jibble (screenshots only; ELEVATE is the time clock) ---
# Client ID + Secret from Jibble: Organization Settings -> API Credentials.
# The app exchanges them for a short-lived access token (confirm the flow in docs.api.jibble.io).
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=
JIBBLE_API_BASE_URL=
JIBBLE_MIRROR_ENABLED=true                 # mirror ELEVATE clock-in/out to Jibble so screenshots run; false = fallback mode
JIBBLE_MISMATCH_MINUTES=15                 # fallback mode: nightly check flags days where ELEVATE and Jibble differ by more

# --- Time clock ---
# Per-team rules (allowed IP ranges, selfie required, idle prompt minutes, grace period)
# live in Settings -> Time clock in the database, not here.
CLOCK_MISSED_CLOCKOUT_GRACE_MINUTES=60     # default grace after shift end before the missed clock-out alert

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="ELEVATE <no-reply@mail.example.com>"

# --- Background jobs (Inngest) ---
# Local development: set INNGEST_DEV=1 and run `pnpm dlx inngest-cli@latest dev` (no keys). Never set it in production:
# there the endpoint requires the signing key and refuses everything else.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cron (Vercel) ---
CRON_SECRET=                               # random string; cron routes reject requests without it

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Safe Voice (separate subdomain/app) ---
SAFEVOICE_DATABASE_URL=                    # dedicated DB role limited to ops.safevoice_* tables
SAFEVOICE_PASSPHRASE_PEPPER=               # random string mixed into case passphrase hashes
