# ELEVATE environment variables
# Copy to .env.local for development. Never commit real values.
# In Vercel: Production -> Supabase Pro project, Preview -> Supabase staging project.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ELEVATE

# --- Supabase (auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # publishable (anon) key: safe in browser, reads nothing (RLS deny-all)
SUPABASE_SECRET_KEY=                       # secret (service role) key: server-only, never NEXT_PUBLIC_

# --- Database (Drizzle) ---
DATABASE_URL=                              # transaction pooler, port 6543 (app runtime)
DATABASE_URL_DIRECT=                       # direct or session connection, port 5432 (migrations only)

# --- Field encryption (government IDs, payout details, pay rates) ---
FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64_KEY   # newest key first: v2:...,v1:...

# --- Access control ---
SUPER_ADMIN_EMAILS=                        # comma-separated; bootstraps the first Super Admin on first login

# --- Google (Calendar; sign-in itself is configured in Supabase) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                      # a Web client for Calendar (separate from the one Supabase uses for sign-in); see docs/SETUP.md section 6

# --- Jibble (screenshots only; ELEVATE is the time clock) ---
# Real values go in the git-ignored file apps/elevate/.env.jibble.local for local tests (pnpm jibble:probe), and in the host's
# environment settings in production. Never in chat, git or this file.
# Either a personal access token (works on the free plan; it acts as the person who made it) ...
JIBBLE_ACCESS_TOKEN=
# ... or, on plans that have them, a Client ID and Secret (the app fetches a short-lived token itself).
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=
# Only if Jibble ever moves its hosts (defaults are the production API):
# JIBBLE_IDENTITY_URL=https://identity.prod.jibble.io
# JIBBLE_WORKSPACE_URL=https://workspace.prod.jibble.io
# JIBBLE_TIME_TRACKING_URL=https://time-tracking.prod.jibble.io
# JIBBLE_TIME_ATTENDANCE_URL=https://time-attendance.prod.jibble.io
JIBBLE_MIRROR_ENABLED=true                 # true = ELEVATE starts and stops Jibble for teams that use it; false = fallback (people clock into both apps, ELEVATE only compares nightly)
JIBBLE_BREAK_MODE=native                   # native = Jibble's own break types, matched by length (create them in Jibble); clock = a break clocks out and back in; off = breaks are not sent
# ELEVATE sends to Jibble only when ELEVATE_ENV=production (set it only on the production deployment). Elsewhere only these Jibble person ids (comma separated, test people only) are sent.
JIBBLE_TEST_PERSON_IDS=
JIBBLE_MISMATCH_MINUTES=15                 # the nightly check flags days where ELEVATE and Jibble differ by more than this

# --- Time clock ---
# Per-team rules (allowed IP ranges, selfie required, idle prompt minutes, grace period)
# live in Settings -> Time clock in the database, not here.
CLOCK_MISSED_CLOCKOUT_GRACE_MINUTES=60     # default grace after shift end before the missed clock-out alert

# --- Email (Resend) ---
RESEND_API_KEY=
# Use a monitored address, not "no-reply": inbox providers trust two-way senders more (Resend flags no-reply).
EMAIL_FROM="ELEVATE <hello@mail.example.com>"
EMAIL_REPLY_TO="hr@example.com"            # where replies go; a real, monitored mailbox
EMAIL_APPLICANT_BCC=""                     # optional: a shared mailbox that gets a silent copy of every applicant email

# --- Background jobs (Inngest) ---
# Local development: set INNGEST_DEV=1 and run `pnpm dlx inngest-cli@latest dev` (no keys). Never set it in production:
# there the endpoint requires the signing key and refuses everything else.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cron (Vercel) ---
CRON_SECRET=                               # random string; cron routes reject requests without it

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Safe Voice (the anonymous app is separate: apps/safe-voice has its own .env.example) ---
# ELEVATE reads and answers Safe Voice cases through its OWN restricted database role, safevoice_handler (not DATABASE_URL).
# Give the role a login in the SQL editor (ALTER ROLE safevoice_handler LOGIN PASSWORD '...') and put the connection string here.
# On the Supabase pooler the user name is safevoice_handler.<project-ref>. Never commit it. Without it the cases page says "not connected".
SAFEVOICE_HANDLER_DATABASE_URL=
