# ELEVATE Learn environment variables. Copy to .env.local for development. Never commit real values.
# This app has NO Supabase keys and none of ELEVATE's secrets on purpose: people arrive through a one-time handoff from ELEVATE.

# The Learn database role, learn_app (created by an ELEVATE migration with no login; ops sets the password out of band):
#   ALTER ROLE learn_app LOGIN PASSWORD '...';
# On the Supabase pooler the user name is learn_app.<project-ref>.
LEARN_DATABASE_URL=

# Where ELEVATE lives (public address, not a secret). Used to send people to sign in.
NEXT_PUBLIC_ELEVATE_URL=http://localhost:3000

# Rate limiting (Upstash Redis). Without it the app allows requests in development and REFUSES them in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
