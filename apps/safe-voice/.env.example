# Safe Voice environment variables. Copy to .env.local for development. Never commit real values.
# This app has NO Supabase keys, no auth and no ELEVATE secrets on purpose: it can only reach the three ops.safevoice_* tables.

# The reporter-facing database role, safevoice_app (created by migration 0037 with no login; ops sets its password out of band):
#   ALTER ROLE safevoice_app LOGIN PASSWORD '...';
# On the Supabase pooler the user name is safevoice_app.<project-ref>. Use the pooler (port 6543) or the direct host.
SAFEVOICE_DATABASE_URL=

# A long random secret (at least 32 characters, for example `openssl rand -base64 48`) mixed into every case code and passphrase hash.
# Keep copies in the password manager and NEVER change it: changing it locks every reporter out of their case.
SAFEVOICE_PEPPER=

# Rate limiting (Upstash Redis). Without it the app allows requests in development and REFUSES them in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
