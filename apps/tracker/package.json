{
  "name": "elevate-tracker",
  "version": "1.0.3",
  "private": true,
  "description": "ELEVATE Tracker App (Windows first): a tray app that clocks in and out through ELEVATE and records app names, idle time and blurred screenshots while clocked in.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:win": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7"
  }
}
