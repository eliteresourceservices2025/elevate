{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ELEVATE Tracker App",
  "version": "1.0.2",
  "identifier": "com.eliteresourceservices.elevate-tracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "status",
        "title": "ELEVATE Tracker App",
        "width": 440,
        "height": 700,
        "resizable": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Elite Resource Services",
    "copyright": "Copyright (c) Elite Resource Services",
    "shortDescription": "Clock in and out, and share activity with ELEVATE",
    "longDescription": "The ELEVATE Tracker App lets you clock in, take breaks and clock out, and shares which program is in front, whether you are active or idle, and a blurred picture of your screens with ELEVATE while you are clocked in.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQzk0QUU2OTU2RUFFODEKUldTQnJtNlY1a3JKOFdqNTFsOEp6cGx6enJLWTI5M21mU1dIamhHaVVrTkFKcHl1STlicHNhNmYK"
    }
  }
}
